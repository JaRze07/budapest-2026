{
  "rules": {
    ".read": true,
    ".write": false,
    "test": {
      ".read": true,
      ".write": true
    },
    "picks": {
      "$name": {
        ".write": "newData.exists() && $name.matches(/^(Areeb|Nhi|Phuong|Jacek)$/)",
        ".validate": "newData.hasChildren(['when'])",
        "ids": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          }
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stay": {
      "$name": {
        ".write": "newData.exists() && $name.matches(/^(Areeb|Nhi|Phuong|Jacek)$/)",
        ".validate": "newData.hasChildren(['when'])",
        "r": {
          "$opt": {
            ".validate": "newData.isString() && newData.val().matches(/^(yes|ok|no)$/)"
          }
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "hype": {
      "$name": {
        ".write": "newData.exists() && $name.matches(/^(Areeb|Nhi|Phuong|Jacek)$/)",
        ".validate": "newData.hasChildren(['level','when'])",
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "files": {
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['data','by','when'])",
        "data": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 700000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "by": {
          ".validate": "newData.val().matches(/^(Areeb|Nhi|Phuong|Jacek)$/)"
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "assign": {
      "$slot": {
        ".write": "$slot.matches(/^(nhiBefore|nhiAfter)$/)",
        ".validate": "newData.isString() && newData.val().length <= 24"
      }
    },
    "customs": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['id','name','by','cat'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 90"
        },
        "by": {
          ".validate": "newData.val().matches(/^(Areeb|Nhi|Phuong|Jacek)$/)"
        },
        "cat": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "final": {
      "$name": {
        ".write": "newData.exists() && $name.matches(/^(Areeb|Nhi|Phuong|Jacek)$/)",
        ".validate": "newData.hasChildren(['when'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "expenses": {
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['title','amount','paidBy','mode','when'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "currency": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "paidBy": {
          ".validate": "newData.val().matches(/^(Areeb|Nhi|Phuong|Jacek)$/)"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "mode": {
          ".validate": "newData.val().matches(/^(equal|units|share|fixed)$/)"
        },
        "by": {
          "$who": {
            ".validate": "$who.matches(/^(Areeb|Nhi|Phuong|Jacek)$/) && newData.isNumber() && newData.val() >= 0"
          }
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "when": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "plan": {
      "$activity": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().matches(/^(fri-pm|fri-eve|sat-am|sat-pm|sat-eve|sun-am|sun-pm|sun-eve|mon)?$/)"
      }
    }
  }
}
